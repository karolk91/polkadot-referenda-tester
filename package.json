{
  "name": "polkadot-referenda-tester",
  "version": "1.0.1",
  "description": "CLI tool to test Polkadot referenda execution using Chopsticks",
  "keywords": [
    "polkadot",
    "kusama",
    "governance",
    "opengov",
    "referendum",
    "fellowship",
    "chopsticks",
    "dry-run",
    "cli"
  ],
  "bin": {
    "polkadot-referenda-tester": "dist/cli.js",
    "prt": "dist/cli.js"
  },
  "license": "MIT-0",
  "type": "commonjs",
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "post-tests",
    "npm-shrinkwrap.json"
  ],
  "homepage": "https://github.com/karolk91/polkadot-referenda-tester#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karolk91/polkadot-referenda-tester.git"
  },
  "bugs": {
    "url": "https://github.com/karolk91/polkadot-referenda-tester/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "provenance": true
  },
  "dependencies": {
    "@acala-network/chopsticks": "^1.5.0",
    "@acala-network/chopsticks-core": "^1.5.0",
    "@acala-network/chopsticks-testing": "^1.5.0",
    "@polkadot-api/metadata-builders": "0.15.1",
    "@polkadot-api/substrate-bindings": "0.21.1",
    "@polkadot-api/utils": "0.4.0",
    "@polkadot/api": "^16.5.4",
    "@polkadot/keyring": "^13.0.0",
    "@polkadot/util": "^14.0.1",
    "@polkadot/util-crypto": "^14.0.1",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.1",
    "js-yaml": "^4.3.2",
    "nanospinner": "^1.1.0",
    "polkadot-api": "3.1.0",
    "scale-ts": "^1.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "cli": "ts-node src/cli.ts",
    "build": "tsc",
    "prepare": "tsc",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
